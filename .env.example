# Copy to .env.local and fill in what you use. Everything here is optional in
# development, but NEXT_PUBLIC_SITE_URL should point at the origin the site is
# actually served from — it is used for canonical URLs, Open Graph tags,
# sitemap.xml and robots.txt.

# Canonical origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=https://platecraft-ps.vercel.app

# --- Marketing tags (each loads only when its id is present) ---

# Google Analytics 4 measurement id
NEXT_PUBLIC_GA_ID=

# Google Ads conversion id, for remarketing and conversion tracking
NEXT_PUBLIC_GOOGLE_ADS_ID=

# Meta (Facebook/Instagram) Pixel id
NEXT_PUBLIC_FB_PIXEL_ID=
